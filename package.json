{
  "name": "@laranex/nestjs-myanmar-payments",
  "version": "4.0.0-dev.0",
  "description": "NestJS integration for Myanmar payment gateways: KBZ Pay, Wave Money, AYA Pay, Yoma MMQR and CyberSource. Built on Node Myanmar Payments. Module and injectable service, callback helpers for Express and Fastify, and an auto-submit form route.",
  "keywords": [
    "laranex",
    "nestjs-myanmar-payments",
    "nestjs",
    "nest",
    "myanmar",
    "payments",
    "payment-gateway",
    "kbzpay",
    "wave-money",
    "aya-pay",
    "yoma",
    "mmqr",
    "cybersource"
  ],
  "homepage": "https://laranex.vercel.app/nestjs-myanmar-payments",
  "bugs": {
    "url": "https://github.com/laranex/nestjs-myanmar-payments/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/laranex/nestjs-myanmar-payments.git"
  },
  "license": "MIT",
  "author": "Nay Thu Khant <naythukhant644@gmail.com>",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "files": [
    "dist",
    "skills",
    "CHANGELOG.md",
    "LICENSE.md",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:dist": "node scripts/smoke.mjs && node scripts/smoke.cjs",
    "check:package": "publint --strict && attw --pack .",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@laranex/myanmar-payments": "^4.0.0-dev.0"
  },
  "peerDependencies": {
    "@nestjs/cache-manager": "^2.0.0 || ^3.0.0 || ^12.0.0",
    "@nestjs/common": "^10.0.0 || ^11.0.0 || ^12.0.0",
    "@nestjs/config": "^3.0.0 || ^4.0.0 || ^12.0.0",
    "@nestjs/core": "^10.0.0 || ^11.0.0 || ^12.0.0",
    "rxjs": "^7.1.0"
  },
  "peerDependenciesMeta": {
    "@nestjs/cache-manager": {
      "optional": true
    },
    "@nestjs/config": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@nestjs/cache-manager": "^12.0.1",
    "@nestjs/common": "^12.1.2",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-express": "^12.1.2",
    "@nestjs/platform-fastify": "^12.1.2",
    "@nestjs/testing": "^12.1.2",
    "@types/node": "^20.19.0",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.11",
    "cache-manager": "^7.2.9",
    "eslint": "^10.12.0",
    "keyv": "^5.6.0",
    "prettier": "^3.9.9",
    "publint": "^0.3.25",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "supertest": "^7.3.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
